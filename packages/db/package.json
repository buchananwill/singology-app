{
  "name": "@singology/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:rls": "tsx scripts/runRlsTests.ts",
    "generate": "drizzle-kit generate",
    "generate:private": "tsx scripts/privateMigration.ts",
    "supabase": "tsx scripts/supabaseCli.ts",
    "seed": "tsx src/seed/seedAlpha.ts",
    "seed:counts": "tsx scripts/seedCounts.ts"
  },
  "dependencies": {
    "@singology/shared": "workspace:^",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.1"
  }
}
