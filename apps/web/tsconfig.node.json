{
  "extends": "../../tsconfig.base.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "react-router.config.ts",
    "playwright.config.ts",
    "previewPort.ts",
    "publicDir.ts",
    "e2e/**/*",
    "scripts/**/*",
    "app/auth/confirmLink.ts",
    "app/lib/format.ts",
    "test/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["DOM", "ES2023"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
