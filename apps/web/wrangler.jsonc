{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "singology-facade",
  "compatibility_date": "2026-09-23",
  // `pg` (behind Drizzle) needs Node's net, tls and crypto APIs.
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "assets": {
    // The Cloudflare Vite plugin fills in `directory` with the client build output.
    "binding": "ASSETS",
    // The static-assets handler ignores HTTP Range, so media goes through the Worker's Range-aware
    // route first. Keep in sync with MEDIA_PATH_PREFIX.
    "run_worker_first": ["/media/*"],
  },
  // singology-dev-db, caching disabled.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "997b46ccb23e49e394a600075a67e994" }],
}
