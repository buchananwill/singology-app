{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "singology-facade",
  "compatibility_date": "2026-09-23",
  "main": "./workers/app.ts",
  "assets": {
    // The Cloudflare Vite plugin fills in `directory` with the client build output.
    "binding": "ASSETS",
    // The static-assets handler ignores HTTP Range (pitfall 6), so media goes through the Worker's
    // Range-aware route first (spec decision 31). Keep in sync with MEDIA_PATH_PREFIX.
    "run_worker_first": ["/media/*"]
  }
}
