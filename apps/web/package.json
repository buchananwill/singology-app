{
  "name": "@singology/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars node_modules/@react-router/dev/bin.cjs dev",
    "build": "react-router build",
    "preview": "pnpm run build && vite preview",
    "serve:built": "node --env-file-if-exists=.dev.vars node_modules/wrangler/bin/wrangler.js dev --config build/server/wrangler.json --ip 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && react-router typegen && tsc -b"
  },
  "dependencies": {
    "@mantine/core": "9.6.2",
    "@mantine/hooks": "9.6.2",
    "@mantine/notifications": "9.6.2",
    "@singology/db": "workspace:^",
    "@singology/shared": "workspace:^",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "hls.js": "1.7.3",
    "isbot": "5.1.40",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "wavesurfer.js": "8.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.58.0",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.137.0",
    "zod": "4.6.5"
  }
}
